snippet ;doc "docstring" bA
"""
$0
"""
endsnippet

snippet ;psh "plt show" bA
plt.show()
$0
endsnippet

snippet ;plt "plt plot" bA
plt.plot($0)
endsnippet

snippet ;figax "plt figure and axis" bA
fig, ax = plt.subplots($1, $2, figsize=(`!p t[1]*3`, `!p t[2]*3`))
endsnippet

snippet ;ll "new comment line" bA
# $0
endsnippet

snippet ;== "fstring var print" iA
f"{${1:var}=}"$0
endsnippet

snippet ;pp "print" bA
print($0)
endsnippet

snippet ;-- "comment line" bA
##----------------------------------------------------------------------------##
endsnippet

snippet ;cc "new cell" bA
# %%

$0

# %%
endsnippet

snippet ;md "new markdown cell" bA
# %% [markdown]
# $0

# %%
endsnippet
